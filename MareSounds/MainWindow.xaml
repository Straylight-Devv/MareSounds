<Window x:Class="MareSounds.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MareSounds.UI" 
        xmlns:models="clr-namespace:MareSounds.UI.Models"
        xmlns:vm="clr-namespace:MareSounds.UI.ViewModels" 
        xmlns:views="clr-namespace:MareSounds.UI.Views"
        mc:Ignorable="d"
        Title="Mare Soundboard" Height="720" Width="1280"
        SizeToContent="Manual"  
        DataContext="{models:DISource Type=vm:MainWindowViewModel}"
        WindowStartupLocation="CenterScreen" Icon="/maresounds.ico">
    <Window.Resources>
        <BitmapImage x:Key="BlankImg" UriSource="pack://application:,,,/Resources/blank.jpg" />
    </Window.Resources>
    <Grid>
        <views:MareListView/>
    </Grid>
</Window>
